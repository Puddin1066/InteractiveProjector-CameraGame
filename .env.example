# Reolink / RTSP input
# Use the Reolink sub-stream first for lower latency.
# Example only; never commit real camera credentials.
REOLINK_RTSP_URL=rtsp://username:password@192.168.1.50/Preview_01_sub

# External display index. On a MacBook with one HDMI projector this is usually 1.
PROJECTOR_MONITOR_INDEX=1

# Motion tuning
MOTION_THRESHOLD=45
MINIMUM_MOTION_PIXELS=900
HIT_COOLDOWN_SECONDS=0.28

# Optional diagnostics overlay
HAUNTED_WALL_DEBUG=1
